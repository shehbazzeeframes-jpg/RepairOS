// RepairOS database schema. See packages/db/README.md for tenancy + RLS rules.
// Tenant tables (have shopId + RLS policy): Location, Membership, TaxRate, AuditLog, Invitation, BusinessHours,
// TimeEntry, and the Sprint 2 customer/device/ticket tables. Shop is the tenant root.
// Auth tables (User/Session/Account/Verification) follow Better Auth's Prisma adapter shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Admin/owner connection used by migrations and seed. The API connects as `repairos_app` (APP_DATABASE_URL).
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  FRONT_DESK
  TECHNICIAN
}

enum CountryCode {
  US
  GB
  PK
}

enum CurrencyCode {
  USD
  GBP
  PKR
}

enum TaxAppliesTo {
  all
  goods
  services
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum InviteEmailStatus {
  QUEUED
  SENT
  FAILED
}

enum TimeEntrySource {
  SELF
  MANUAL
}

enum TimeEntryClosedReason {
  DEACTIVATED
}

// ---------- Better Auth ----------

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  auditLogs     AuditLog[]
  timeEntries   TimeEntry[]

  @@map("users")
}

model Session {
  id           String   @id
  expiresAt    DateTime
  token        String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ipAddress    String?
  userAgent    String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The shop the user is working in. Membership is re-validated on every request.
  activeShopId String?
  activeShop   Shop?    @relation(fields: [activeShopId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ---------- Tenancy ----------

model Shop {
  id                    String                 @id @default(cuid())
  name                  String
  country               CountryCode
  currency              CurrencyCode
  locale                String
  timezone              String
  pricesIncludeTax      Boolean
  /// E.164, normalised by the API with the shop's country as default region.
  phone                 String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  region                String?
  postcode              String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  locations             Location[]
  memberships           Membership[]
  taxRates              TaxRate[]
  auditLogs             AuditLog[]
  activeSessions        Session[]
  invitations           Invitation[]
  businessHours         BusinessHours[]
  timeEntries           TimeEntry[]
  customers             Customer[]
  customerPhones        CustomerPhone[]
  customerConsentEvents CustomerConsentEvent[]
  devices               Device[]
  ticketStatuses        TicketStatus[]
  ticketSettings        ShopTicketSettings?
  tickets               Ticket[]
  ticketIssues          TicketIssue[]
  ticketChecklistItems  TicketChecklistItem[]
  ticketAccessories     TicketAccessory[]
  ticketNotes           TicketNote[]
  ticketEvents          TicketEvent[]

  @@map("shops")
}

model Location {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@map("locations")
}

model Membership {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId              String
  shop                Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  role                Role
  /// Only ACTIVE memberships grant access (AuthGuard, /api/me, active-shop switch, RLS shop read).
  status              MembershipStatus @default(ACTIVE)
  deactivatedAt       DateTime?
  deactivatedByUserId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  assignedTickets     Ticket[]
  ticketNotes         TicketNote[]

  @@unique([userId, shopId])
  @@index([shopId])
  @@index([shopId, status, role])
  @@map("memberships")
}

/// Staff invite. The plaintext token (32 random bytes, base64url) is never stored: only its SHA-256.
/// "Expired" is derived (PENDING and expiresAt < now). One PENDING invite per (shopId, email): partial
/// unique index `invitations_pending_email_key` (raw SQL in the migration).
model Invitation {
  id               String            @id @default(cuid())
  shopId           String
  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Trimmed and lower-cased.
  email            String
  role             Role
  tokenHash        String            @unique
  status           InvitationStatus  @default(PENDING)
  expiresAt        DateTime
  invitedByUserId  String?
  lastSentAt       DateTime?
  sendCount        Int               @default(0)
  emailStatus      InviteEmailStatus @default(QUEUED)
  /// Set by "Copy invite link" (D10); accepting then does not set emailVerified (D7).
  linkCopiedAt     DateTime?
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  revokedByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@map("invitations")
}

/// Opening hours, one row per weekday (0 = Sunday … 6 = Saturday). Times are "HH:mm" shop-local.
model BusinessHours {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  weekday   Int
  isOpen    Boolean
  opensAt   String?
  closesAt  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, weekday])
  @@map("business_hours")
}

/// Clock in/out. One open entry (clockOutAt IS NULL) per (shopId, userId): partial unique index
/// `time_entries_one_open_key` (raw SQL in the migration). Deleted entries are hard-deleted (audit keeps a snapshot).
model TimeEntry {
  id              String                 @id @default(cuid())
  shopId          String
  shop            Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockInAt       DateTime
  clockOutAt      DateTime?
  closedReason    TimeEntryClosedReason?
  source          TimeEntrySource
  createdByUserId String?
  editedAt        DateTime?
  editedByUserId  String?
  editReason      String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([shopId, clockInAt])
  @@index([shopId, userId, clockInAt])
  @@map("time_entries")
}

model TaxRate {
  id                String       @id @default(cuid())
  shopId            String
  shop              Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name              String
  /// Thousandths of a percent: 8875 = 8.875%, 20000 = 20% (decision D2)
  rateMilliPct      Int
  appliesTo         TaxAppliesTo @default(all)
  /// D1: one default rate for goods and one for services per shop (an `all` rate may be both).
  /// Partial unique indexes keep at most one of each among non-archived rates.
  isDefaultGoods    Boolean      @default(false)
  isDefaultServices Boolean      @default(false)
  /// null = active; archived rates are hidden from pickers but kept for history.
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([shopId])
  @@map("tax_rates")
}

model AuditLog {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict) // audit history must outlive a shop delete
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, actorUserId, createdAt])
  @@index([shopId, action, createdAt])
  @@map("audit_logs")
}

// =====================================================================================================
// Sprint 2: customers, devices, tickets. See docs/stories/sprint2-customers-and-tickets.md and
// packages/db/README.md ("Sprint 2 data"). Rules that hold for every table below:
//  - `shopId` + RLS policy; child rows reference their parent through a composite FK (shopId, parentId),
//    so a row can never point at another shop's parent, even through a bug that bypasses the scoped client.
//  - Columns that list queries filter on under RLS use leakproof types (text, int, timestamp), not Postgres
//    enums: enum `=` is not LEAKPROOF, so RLS would stop it being used as an index condition (see PERF.md).
//  - `customers.searchText` is generated by Postgres; fuzzy (trigram) search goes through the SECURITY DEFINER
//    functions app_search_customers / app_search_devices (see src/search.ts and PERF.md for why).
// =====================================================================================================

enum CustomerKind {
  PERSON
  BUSINESS
}

enum ContactChannel {
  SMS
  WHATSAPP
  EMAIL
  CALL
}

enum PhoneLabel {
  MOBILE
  LANDLINE
  WORK
  OTHER
}

enum ConsentChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum ConsentPurpose {
  MARKETING
}

enum ConsentState {
  GRANTED
  WITHDRAWN
}

enum ConsentSource {
  IN_STORE_VERBAL
  IN_STORE_SIGNED
  ONLINE_FORM
  IMPORT
  CUSTOMER_REQUEST
}

enum DeviceType {
  PHONE
  TABLET
  LAPTOP
  DESKTOP
  CONSOLE
  WATCH
  OTHER
}

enum LockType {
  NONE
  PIN
  PASSWORD
  PATTERN
  NOT_SHARED
}

enum TicketStatusRole {
  INITIAL
  COLLECTED
  CANCELLED
}

enum TicketPriority {
  NORMAL
  URGENT
}

enum CancelReason {
  CUSTOMER_DECLINED
  CUSTOMER_TOOK_BACK
  CREATED_BY_MISTAKE
  DUPLICATE
  OTHER
}

enum ChecklistResult {
  PASS
  FAIL
  UNTESTED
}

enum NoteVisibility {
  INTERNAL
  CUSTOMER
}

/// Timeline event kinds (§5.3, §5.9). attachment_added (Sprint 3 photos) and the ones after it are reserved.
enum TicketEventType {
  created
  status_changed
  assigned
  fields_changed
  device_changed
  customer_changed
  note_added
  note_edited
  cancelled
  reopened
  warranty_linked
  passcode_deleted
  attachment_added
  message_sent
  approval_requested
  approval_decided
  item_added
  item_removed
  payment_recorded
}

/// A shop's customer (person or business). Never hard-deleted: archived (`archivedAt`) or erased (`erasedAt`;
/// A11: personal fields nulled by eraseCustomer(), `displayName` = "Erased customer", archived too).
model Customer {
  id                    String          @id @default(cuid())
  shopId                String
  shop                  Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind                  CustomerKind    @default(PERSON)
  firstName             String?
  lastName              String?
  businessName          String?
  businessContactName   String?
  /// Derived and stored by the API: Person "First Last", Business "Business name"; "Erased customer" once erased.
  displayName           String
  /// Trimmed and lower-cased by the API, so the duplicate check is a plain, index-friendly `email = $1`.
  email                 String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  region                String?
  postcode              String?
  notes                 String?
  /// Max 10, each 1-30 chars, first-entered casing (compared case-insensitively by the API).
  tags                  String[]        @default([])
  /// null only after erasure; the API always sets it (PK default WHATSAPP, US/GB SMS).
  preferredChannel      ContactChannel?
  serviceOptOutSms      Boolean         @default(false)
  serviceOptOutEmail    Boolean         @default(false)
  serviceOptOutWhatsapp Boolean         @default(false)
  /// Current marketing consent per channel, denormalised from the latest CustomerConsentEvent of that channel:
  /// when it was granted, or null when not granted (never granted, or withdrawn).
  marketingSmsAt        DateTime?
  marketingEmailAt      DateTime?
  marketingWhatsappAt   DateTime?
  /// Denormalised: createdAt of the customer's latest ticket.
  lastVisitAt           DateTime?
  /// Denormalised: tickets in a non-closed category, maintained in the ticket transaction.
  openTicketCount       Int             @default(0)
  archivedAt            DateTime?
  erasedAt              DateTime?
  /// Optimistic concurrency (STALE_RECORD).
  version               Int             @default(1)
  createdByUserId       String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  /// GENERATED ALWAYS by Postgres: lower(f_unaccent(firstName lastName businessName businessContactName email)).
  /// Only the search SQL reads it, so it is hidden from the Prisma client (it cannot be written).
  searchText            String?         @ignore

  phones        CustomerPhone[]
  consentEvents CustomerConsentEvent[]
  devices       Device[]
  tickets       Ticket[]

  @@unique([shopId, id])
  // Duplicate check (CU2) and email lookups: WHERE "shopId" = $1 AND "email" = $2.
  @@index([shopId, email])
  // Name / business / contact / email "contains" search (any word order), in app_search_customers:
  //   WHERE "searchText" LIKE '%khan%' AND "searchText" LIKE ALL ('{%khan%,%ali%}')
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_search_trgm_idx")
  // "Created (newest)" sort and the created-date filter of the customer list.
  @@index([shopId, createdAt(sort: Desc), id])
  // Partial indexes (raw SQL in the migration): customers_active_name_idx, customers_active_last_visit_idx.
  @@map("customers")
}

/// Up to 3 phones per customer, stored E.164 (normalised by the API with normalizePhone). Exactly one primary,
/// at most one WhatsApp number (partial unique indexes in the migration).
model CustomerPhone {
  id         String     @id @default(cuid())
  shopId     String
  shop       Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer   @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Cascade)
  e164       String
  /// E.164 without "+", for substring search ("4567" finds +92 300 1234567). CHECK: digits = e164 minus "+".
  digits     String
  label      PhoneLabel @default(MOBILE)
  isPrimary  Boolean    @default(false)
  /// The customer's WhatsApp number (the story's Customer.whatsappPhoneId).
  isWhatsapp Boolean    @default(false)
  position   Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([customerId, e164])
  // Exact phone match (search with a full number, duplicate check): WHERE "shopId" = $1 AND "e164" = $2.
  @@index([shopId, e164])
  // Phones of a customer (composite FK, customer detail).
  @@index([shopId, customerId])
  // Phone substring search, 4+ digits ("4567" finds +92 300 1234567), in app_search_customers:
  //   WHERE "digits" LIKE '%4567%'
  @@index([digits(ops: raw("gin_trgm_ops"))], type: Gin, map: "customer_phones_digits_trgm_idx")
  @@map("customer_phones")
}

/// Append-only marketing consent history (CU4). The app role may INSERT and DELETE (erasure) but not UPDATE.
model CustomerConsentEvent {
  id               String         @id @default(cuid())
  shopId           String
  shop             Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId       String
  customer         Customer       @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Cascade)
  channel          ConsentChannel
  purpose          ConsentPurpose @default(MARKETING)
  state            ConsentState
  /// Required when granting (API rule); a withdrawal defaults to CUSTOMER_REQUEST.
  source           ConsentSource
  note             String?
  recordedByUserId String?
  createdAt        DateTime       @default(now())

  // Consent history of a customer, and the latest event per channel.
  @@index([shopId, customerId, channel, createdAt(sort: Desc)])
  @@map("customer_consent_events")
}

/// A customer's device. IMEI (15 digits) and serial ([A-Z0-9]{4,30}) are stored normalised (CHECK constraints).
/// Passcode (A15): AES-256-GCM via src/field-crypto.ts. Ciphertext, IV, tag and key version are all set or all
/// null (CHECK). The API never returns them: only `lockType` and `passcodeSetAt`.
model Device {
  id                         String     @id @default(cuid())
  shopId                     String
  shop                       Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId                 String
  customer                   Customer   @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict)
  type                       DeviceType
  brand                      String
  model                      String
  colour                     String?
  imei                       String?
  serial                     String?
  lockType                   LockType   @default(NONE)
  passcodeCiphertext         Bytes?
  passcodeIv                 Bytes?
  passcodeTag                Bytes?
  passcodeKeyVersion         Int?
  passcodeSetAt              DateTime?
  passcodeViewCount          Int        @default(0)
  passcodeLastViewedAt       DateTime?
  passcodeLastViewedByUserId String?
  notes                      String?
  createdByUserId            String?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  archivedAt                 DateTime?

  tickets Ticket[]

  @@unique([shopId, id])
  /// Target of the ticket FK (shopId, customerId, deviceId): a ticket's device belongs to the ticket's customer.
  @@unique([shopId, customerId, id])
  // "Models used before" suggestions (DV1.2): WHERE "shopId" = $1 AND "brand" = $2 GROUP BY "model".
  @@index([shopId, brand, model])
  // More (raw SQL): devices_imei_idx, devices_serial_idx, devices_imei_trgm_idx, devices_serial_trgm_idx.
  @@map("devices")
}

/// Configurable ticket statuses (§3), seeded per shop by app_ensure_ticket_defaults(). `systemRole` marks the
/// protected statuses (INITIAL, COLLECTED, CANCELLED): renamable, not hideable, category fixed (API rules).
/// Never deleted (A9). Unique (shopId, lower(name)) is a raw-SQL index (ticket_statuses_name_key).
model TicketStatus {
  id             String            @id @default(cuid())
  shopId         String
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name           String
  /// OPEN | WAITING | READY | CLOSED (CHECK constraint). Text, not an enum: see the header comment.
  category       String
  systemRole     TicketStatusRole?
  /// Astryx Badge variant (neutral, info, success, warning, error, blue, ...), validated by contracts.
  colour         String            @default("neutral")
  position       Int
  isHidden       Boolean           @default(false)
  notifyCustomer Boolean           @default(false)
  /// Moving a ticket into this status needs a note (seeded true for Unrepairable).
  requiresNote   Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tickets            Ticket[]
  ticketsBeforeClose Ticket[] @relation("TicketStatusBeforeClose")

  @@unique([shopId, id])
  /// FK target of tickets (shopId, statusId, statusCategory) ON UPDATE CASCADE: changing a status's category
  /// re-categorises its tickets in the same statement, so the denormalised column cannot drift.
  @@unique([shopId, id, category])
  /// One status per system role per shop (NULLs are distinct, so custom statuses are unaffected).
  @@unique([shopId, systemRole])
  // Statuses in order (settings page, pickers).
  @@index([shopId, position])
  @@map("ticket_statuses")
}

/// Ticket settings (§4), one row per shop, seeded by app_ensure_ticket_defaults().
/// `nextNumber` is the gapless counter (A4; the story's ShopCounter): only nextTicketNumber() increments it,
/// with UPDATE ... RETURNING inside the ticket-create transaction. Settings may only raise it.
model ShopTicketSettings {
  id                    String   @id @default(cuid())
  shopId                String   @unique
  shop                  Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  nextNumber            Int      @default(1001)
  /// 0-5 chars [A-Z-], display only.
  numberPrefix          String   @default("T-")
  /// 0-30 open days.
  defaultTurnaroundDays Int      @default(2)
  deletePasscodeOnClose Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("shop_ticket_settings")
}

/// A repair ticket (one device per ticket, A21). Issues, checklist and accessories are child tables.
model Ticket {
  id                  String         @id @default(cuid())
  shopId              String
  shop                Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Gapless per shop (A4), from nextTicketNumber(). Displayed as `{numberPrefix}{number}`.
  number              Int
  statusId            String
  /// Denormalised TicketStatus.category (OPEN | WAITING | READY | CLOSED), kept equal by the composite FK.
  statusCategory      String
  status              TicketStatus   @relation(fields: [shopId, statusId, statusCategory], references: [shopId, id, category], onDelete: Restrict, onUpdate: Cascade)
  statusChangedAt     DateTime       @default(now())
  /// The status the ticket was in when it was closed (contract `statusBeforeClose`, the Reopen default target);
  /// null while open.
  statusIdBeforeClose String?
  statusBeforeClose   TicketStatus?  @relation("TicketStatusBeforeClose", fields: [shopId, statusIdBeforeClose], references: [shopId, id], onDelete: Restrict)
  priority            TicketPriority @default(NORMAL)
  customerId          String
  customer            Customer       @relation(fields: [shopId, customerId], references: [shopId, id], onDelete: Restrict)
  deviceId            String
  device              Device         @relation(fields: [shopId, customerId, deviceId], references: [shopId, customerId, id], onDelete: Restrict)
  /// A member of this shop (composite FK to memberships); may be deactivated later (then listed as Unassigned).
  assigneeUserId      String?
  assignee            Membership?    @relation(fields: [assigneeUserId, shopId], references: [userId, shopId], onDelete: Restrict)
  description         String?
  conditionNotes      String?
  accessoriesOther    String?
  /// Integer minor units of `currency` (shop currency snapshot); null = no estimate.
  estimateMinor       Int?
  currency            CurrencyCode
  dueAt               DateTime
  dueHasTime          Boolean        @default(false)
  /// The root original ticket of a warranty ticket (a warranty ticket is never an original: API rule).
  warrantyOfTicketId  String?
  warrantyOf          Ticket?        @relation("TicketWarranty", fields: [shopId, warrantyOfTicketId], references: [shopId, id], onDelete: Restrict)
  warrantyTickets     Ticket[]       @relation("TicketWarranty")
  cancelReason        CancelReason?
  cancelNote          String?
  /// "Device and accessories returned to the customer" confirmation on cancel (TK-C.2; contract `returnedConfirmed`).
  returnedConfirmed   Boolean        @default(false)
  closedAt            DateTime?
  reopenCount         Int            @default(0)
  version             Int            @default(1)
  createdByUserId     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  issues         TicketIssue[]
  checklistItems TicketChecklistItem[]
  accessories    TicketAccessory[]
  notes          TicketNote[]
  events         TicketEvent[]

  @@unique([shopId, id])
  // Ticket number search / "jump to T-1042": WHERE "shopId" = $1 AND "number" = $2. Also gapless uniqueness.
  @@unique([shopId, number])
  // Ticket views and dashboard counts (§5.2, §6):
  //   All open: WHERE "shopId" = $1 AND "statusCategory" IN ('OPEN','WAITING','READY') ORDER BY priority DESC, "dueAt"
  //   Ready:    WHERE "shopId" = $1 AND "statusCategory" = 'READY' ...
  //   Overdue / due today / due range: ... "statusCategory" IN ('OPEN','WAITING') AND "dueAt" < $2
  //   Counts:   count(*) FILTER (...) WHERE "shopId" = $1 AND "statusCategory" IN ('OPEN','WAITING','READY')
  // The trailing assigneeUserId and priority make the counts (Mine / Unassigned / Urgent) index-only scans.
  @@index([shopId, statusCategory, dueAt, id, assigneeUserId, priority], map: "tickets_status_due_idx")
  // Mine (technician queue, dashboard "My queue"):
  //   WHERE "shopId" = $1 AND "assigneeUserId" = $2 AND "statusCategory" IN ('OPEN','WAITING','READY') ORDER BY ...
  @@index([shopId, assigneeUserId, statusCategory, dueAt], map: "tickets_assignee_idx")
  // "Created (newest)" sort and the created-date filter: WHERE "shopId" = $1 ORDER BY "createdAt" DESC, "id"
  @@index([shopId, createdAt(sort: Desc), id], map: "tickets_created_idx")
  // Closed view (history), closed date newest: WHERE "shopId" = $1 AND "statusCategory" = 'CLOSED'
  //   ORDER BY "closedAt" DESC, "id"
  @@index([shopId, statusCategory, closedAt(sort: Desc), id], map: "tickets_closed_idx")
  // Customer's Tickets tab, ticket search by customer, open-ticket guards (archive/erase), FK checks:
  //   WHERE "shopId" = $1 AND "customerId" = $2 ORDER BY "createdAt" DESC
  @@index([shopId, customerId, createdAt(sort: Desc)], map: "tickets_customer_idx")
  // Device history ("3 previous tickets", "T-1040 is still open for this device"), ticket search by IMEI/serial:
  //   WHERE "shopId" = $1 AND "deviceId" = $2 ORDER BY "createdAt" DESC
  @@index([shopId, deviceId, createdAt(sort: Desc)], map: "tickets_device_idx")
  // Ticket count per status (settings page) and the ON UPDATE CASCADE of a status category change:
  //   WHERE "shopId" = $1 AND "statusId" = $2
  @@index([shopId, statusId], map: "tickets_status_idx")
  // Partial index (raw SQL in the migration): tickets_warranty_idx.
  @@map("tickets")
}

/// Reported issues (0-10 per ticket; at least one issue or a description: API rule).
model TicketIssue {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    Ticket   @relation(fields: [shopId, ticketId], references: [shopId, id], onDelete: Cascade)
  /// Preset code from contracts (ISSUE_PRESETS_BY_DEVICE_TYPE); null for a free-text issue.
  code      String?
  label     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  // Issues of a ticket in order (detail, list "first 2 + n").
  @@index([shopId, ticketId, position])
  @@map("ticket_issues")
}

/// Pre-repair condition checklist, one row per item (keys from contracts CHECKLIST_ITEMS_BY_DEVICE_TYPE).
model TicketChecklistItem {
  id        String          @id @default(cuid())
  shopId    String
  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    Ticket          @relation(fields: [shopId, ticketId], references: [shopId, id], onDelete: Cascade)
  itemKey   String
  result    ChecklistResult @default(UNTESTED)
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([shopId, ticketId, itemKey])
  @@map("ticket_checklist_items")
}

/// Accessories left with the device (codes from contracts ACCESSORY_CODES; "Other" text in Ticket.accessoriesOther).
model TicketAccessory {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    Ticket   @relation(fields: [shopId, ticketId], references: [shopId, id], onDelete: Cascade)
  code      String
  createdAt DateTime @default(now())

  @@unique([shopId, ticketId, code])
  @@map("ticket_accessories")
}

/// Ticket notes (A20): internal by default; the author may edit for 10 minutes (`editedAt`); never deleted;
/// visibility fixed after posting. Kept on customer erasure (A11).
model TicketNote {
  id           String         @id @default(cuid())
  shopId       String
  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticketId     String
  ticket       Ticket         @relation(fields: [shopId, ticketId], references: [shopId, id], onDelete: Cascade)
  authorUserId String
  author       Membership     @relation(fields: [authorUserId, shopId], references: [userId, shopId], onDelete: Restrict)
  visibility   NoteVisibility @default(INTERNAL)
  body         String
  editedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  events TicketEvent[]

  @@unique([shopId, id])
  // Notes of a ticket in order (timeline "Notes" filter, export of customer-visible notes).
  @@index([shopId, ticketId, createdAt])
  @@map("ticket_notes")
}

/// Append-only ticket timeline (A12); the app role may only INSERT and SELECT.
/// `data` holds ids, codes and field values: never customer contact data, IMEI/serial or a passcode.
model TicketEvent {
  id          String          @id @default(cuid())
  shopId      String
  shop        Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticketId    String
  ticket      Ticket          @relation(fields: [shopId, ticketId], references: [shopId, id], onDelete: Cascade)
  /// null = system.
  actorUserId String?
  type        TicketEventType
  data        Json            @default("{}")
  noteId      String?
  note        TicketNote?     @relation(fields: [shopId, noteId], references: [shopId, id], onDelete: Restrict)
  createdAt   DateTime        @default(now())

  // Timeline of a ticket, cursor-paginated: WHERE "shopId" = $1 AND "ticketId" = $2 ORDER BY "createdAt", "id".
  @@index([shopId, ticketId, createdAt, id])
  @@map("ticket_events")
}
