# --- Runtime mode (REQUIRED by the API and worker; they refuse to start without it) ---
# development | test | production. Anything other than development/test is treated as production:
# RESEND_API_KEY and EMAIL_FROM (and, for the worker, APP_DATABASE_URL) become required.
# Only the API and worker read this file's NODE_ENV; the web app's `next build` / `next start` set their own.
NODE_ENV=development

# --- Database & cache ---
# Owner/admin connection: used by migrations and seed only (table owner, so RLS does not apply).
DATABASE_URL=postgresql://repairos:repairos@localhost:5432/repairos
# Runtime connection for the API/worker (REQUIRED): non-superuser role `repairos_app`, so Row-Level Security
# applies. The API refuses to start if this role is a superuser, has BYPASSRLS or owns the tables.
# `pnpm db:migrate` sets this role's password from here. Roles are cluster-wide: use the same password in *_TEST.
APP_DATABASE_URL=postgresql://repairos_app:change-me@localhost:5432/repairos
# Used by tests; a separate database that is reset per run
DATABASE_URL_TEST=postgresql://repairos:repairos@localhost:5432/repairos_test
APP_DATABASE_URL_TEST=postgresql://repairos_app:change-me@localhost:5432/repairos_test
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Public URL of the web app; the browser talks to the API through the web app's /api proxy
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Auth rate limits per minute: failed sign-ins per IP+email (and 5x that per IP), sign-ups per IP,
# password resets per IP+email
AUTH_RATE_LIMIT_MAX=10
# Express "trust proxy": which proxies may set X-Forwarded-For (true/false, hop count, or
# addresses such as "loopback" or "loopback, 10.0.0.0/8"). Default loopback = the web app's local proxy.
TRUST_PROXY=loopback

# --- API ---
PORT=4000
# pino level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Email (D6) ---
# Without RESEND_API_KEY, emails are written to <repo>/.outbox/ (development/test only). With any other NODE_ENV
# the API and worker refuse to start without RESEND_API_KEY and EMAIL_FROM.
EMAIL_FROM="RepairOS <no-reply@repairos.local>"
# EMAIL_OUTBOX_DIR=/absolute/path/to/.outbox
# queue (BullMQ, sent by apps/worker with retries; default) or sync (in-process; default in tests)
# EMAIL_DELIVERY=queue
# Dev outbox API (GET /api/dev/outbox, read by the web app's /dev/outbox page and the real-stack E2E suite).
# Served only when DEV_OUTBOX=1 AND RESEND_API_KEY is unset AND NODE_ENV is development or test; 404 otherwise.
DEV_OUTBOX=1

# --- Limits ---
# Shops one user may own (ACTIVE OWNER memberships) and shop creations per user per hour
SHOP_OWNED_LIMIT=3
SHOP_CREATE_PER_HOUR=5
# Public invite preview requests per IP per minute
INVITE_PREVIEW_RATE_LIMIT=30
# Password-reset emails per account per hour, across all IPs (counted in the database, survives restarts)
PASSWORD_RESET_PER_EMAIL_HOUR=5

# --- Encryption for device passcodes (32-byte base64) ---
FIELD_ENCRYPTION_KEY=change-me

# --- Integrations ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
