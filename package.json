{
  "name": "repairos",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @repairos/e2e test",
    "e2e:real": "pnpm --filter @repairos/e2e test:real",
    "db:migrate": "pnpm --filter @repairos/db migrate",
    "db:seed": "pnpm --filter @repairos/db seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
