{
  "name": "@repairos/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --clean",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "pino": "^9.6.0",
    "@repairos/email": "workspace:*",
    "@repairos/db": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^2.1.9"
  }
}
