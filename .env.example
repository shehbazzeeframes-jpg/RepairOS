# --- Database & cache ---
# Owner/admin connection: used by migrations and seed only (table owner, so RLS does not apply).
DATABASE_URL=postgresql://repairos:repairos@localhost:5432/repairos
# Runtime connection for the API/worker: non-superuser role `repairos_app`, so Row-Level Security applies.
# `pnpm db:migrate` sets this role's password from here. Roles are cluster-wide: use the same password in *_TEST.
APP_DATABASE_URL=postgresql://repairos_app:change-me@localhost:5432/repairos
# Used by tests; a separate database that is reset per run
DATABASE_URL_TEST=postgresql://repairos:repairos@localhost:5432/repairos_test
APP_DATABASE_URL_TEST=postgresql://repairos_app:change-me@localhost:5432/repairos_test
REDIS_URL=redis://localhost:6379

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Public URL of the web app; the browser talks to the API through the web app's /api proxy
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Max sign-in / sign-up / password-reset requests per IP per minute
AUTH_RATE_LIMIT_MAX=10

# --- API ---
PORT=4000
# pino level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Encryption for device passcodes (32-byte base64) ---
FIELD_ENCRYPTION_KEY=change-me

# --- Integrations (Sprint 3+) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
